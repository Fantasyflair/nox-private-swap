# ─── Contracts (Ethereum Sepolia) ───────────────────────────────────────────
# Official Uniswap V2 Router02
NEXT_PUBLIC_UNISWAP_V2_ROUTER=0xeE567Fe1712Faf6149d80dA1E6934E354124CfE3

# Your deployed PrivateSwapRouter (set after forge deploy)
NEXT_PUBLIC_PRIVATE_SWAP_ROUTER=0xYourDeployedAddressHere

# ─── RPC ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Prefer a dedicated key (Alchemy / Infura / QuickNode) for production demos
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ─── Deployment ─────────────────────────────────────────────────────────────
PRIVATE_KEY=0xYourDeployerPrivateKey
ETHERSCAN_API_KEY=YourEtherscanKey

# ─── Nox (when integrating live Handle Gateway) ─────────────────────────────
# See https://docs.iex.ec/nox-protocol and @iexec-nox/handle docs
# NOX_GATEWAY_URL=
# NOX_COMPUTE_ADDRESS=
